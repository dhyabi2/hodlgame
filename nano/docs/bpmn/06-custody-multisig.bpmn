<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_custody"
  targetNamespace="https://holdfun.io/bpmn">

  <!-- ======================================================================
  Flow 06 — 2-of-3 multisig custody (how the XNO is guarded with no contract)
  ======================================================================
  Three independent Ed25519 keys: the OPERATOR key (HD-derived from POOL_SEED)
  plus GUARDIAN-1 and GUARDIAN-2 (independently generated, held off-machine).
  A payout block is valid only when it carries 2 of 3 signatures over the same
  block hash. The guardian never signs blind — it re-verifies the target pool,
  the balance, and a fresh requestId (anti-replay) before co-signing.
  ====================================================================== -->

  <bpmn:process id="Process_Custody" name="2-of-3 multisig payout" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Custody">
      <bpmn:lane id="Lane_Custody_Operator" name="Operator (custody)">
        <bpmn:flowNodeRef>Event_Custody_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Hash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_OpSig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Custody_Quorum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Broadcast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Custody_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Custody_Guardian" name="Guardian (guardian.ts)">
        <bpmn:flowNodeRef>Event_Custody_Recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Replay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Balance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_Rehash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Custody_GuardSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Custody_Respond</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Operator -->
    <bpmn:startEvent id="Event_Custody_Start" name="payout to sign">
      <bpmn:outgoing>Flow_Custody_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Custody_Hash" name="payoutBlockHash(pool, payout)">
      <bpmn:documentation>Hash the exact block: account, previous, representative, newBalance, link.</bpmn:documentation>
      <bpmn:incoming>Flow_Custody_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_OpSig" name="cosignHash(pool.secretKey, hash) → operator signature">
      <bpmn:incoming>Flow_Custody_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Collect" name="remoteCosign(url, apiKey, {account, previous, balance, link})">
      <bpmn:documentation>POST /sign to each guardian; collect signatures.</bpmn:documentation>
      <bpmn:incoming>Flow_Custody_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Custody_Quorum" name="≥ 2 of 3 signatures?">
      <bpmn:incoming>Flow_Custody_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Custody_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Custody_Assemble" name="signPayoutWithSignatures(pool, payout, rpcKey, cosigs)">
      <bpmn:documentation>block.signatures = [operatorSig, ...cosignerSigs].</bpmn:documentation>
      <bpmn:incoming>Flow_Custody_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Work" name="rpc work_generate (send difficulty)">
      <bpmn:incoming>Flow_Custody_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Broadcast" name="broadcastPayout (rpc action=process)">
      <bpmn:incoming>Flow_Custody_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Custody_Done" name="payout confirmed">
      <bpmn:incoming>Flow_Custody_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="Event_Custody_NoQuorum" name="abort (no quorum)">
      <bpmn:incoming>Flow_Custody_6</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Guardian -->
    <bpmn:startEvent id="Event_Custody_Recv" name="POST /sign received">
      <bpmn:outgoing>Flow_Custody_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Custody_Auth" name="check apiKey == GUARDIAN_KEY">
      <bpmn:incoming>Flow_Custody_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_11</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Replay" name="requestId anti-replay (seen map, 1h window)">
      <bpmn:incoming>Flow_Custody_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Guard" name="account ∈ GUARDED_POOLS?">
      <bpmn:incoming>Flow_Custody_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Balance" name="balance covers payout (balance > 0, numeric)?">
      <bpmn:incoming>Flow_Custody_13</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_Rehash" name="hashBlock(account, previous, representative, balance, link)">
      <bpmn:documentation>Never trust a caller hash — recompute it.</bpmn:documentation>
      <bpmn:incoming>Flow_Custody_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_15</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Custody_GuardSign" name="signBlock({ hash, secretKey: GUARDIAN_SEED })">
      <bpmn:incoming>Flow_Custody_15</bpmn:incoming>
      <bpmn:outgoing>Flow_Custody_16</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Custody_Respond" name="200 { signature, publicKey, account }">
      <bpmn:incoming>Flow_Custody_16</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Custody_1" sourceRef="Event_Custody_Start" targetRef="Task_Custody_Hash"/>
    <bpmn:sequenceFlow id="Flow_Custody_2" sourceRef="Task_Custody_Hash" targetRef="Task_Custody_OpSig"/>
    <bpmn:sequenceFlow id="Flow_Custody_3" sourceRef="Task_Custody_OpSig" targetRef="Task_Custody_Collect"/>
    <bpmn:sequenceFlow id="Flow_Custody_4" sourceRef="Task_Custody_Collect" targetRef="Gateway_Custody_Quorum"/>
    <bpmn:sequenceFlow id="Flow_Custody_5" sourceRef="Gateway_Custody_Quorum" targetRef="Task_Custody_Assemble" name="quorum"/>
    <bpmn:sequenceFlow id="Flow_Custody_6" sourceRef="Gateway_Custody_Quorum" targetRef="Event_Custody_NoQuorum" name="no quorum"/>
    <bpmn:sequenceFlow id="Flow_Custody_7" sourceRef="Task_Custody_Assemble" targetRef="Task_Custody_Work"/>
    <bpmn:sequenceFlow id="Flow_Custody_8" sourceRef="Task_Custody_Work" targetRef="Task_Custody_Broadcast"/>
    <bpmn:sequenceFlow id="Flow_Custody_9" sourceRef="Task_Custody_Broadcast" targetRef="Event_Custody_Done"/>
    <bpmn:sequenceFlow id="Flow_Custody_10" sourceRef="Event_Custody_Recv" targetRef="Task_Custody_Auth"/>
    <bpmn:sequenceFlow id="Flow_Custody_11" sourceRef="Task_Custody_Auth" targetRef="Task_Custody_Replay"/>
    <bpmn:sequenceFlow id="Flow_Custody_12" sourceRef="Task_Custody_Replay" targetRef="Task_Custody_Guard"/>
    <bpmn:sequenceFlow id="Flow_Custody_13" sourceRef="Task_Custody_Guard" targetRef="Task_Custody_Balance"/>
    <bpmn:sequenceFlow id="Flow_Custody_14" sourceRef="Task_Custody_Balance" targetRef="Task_Custody_Rehash"/>
    <bpmn:sequenceFlow id="Flow_Custody_15" sourceRef="Task_Custody_Rehash" targetRef="Task_Custody_GuardSign"/>
    <bpmn:sequenceFlow id="Flow_Custody_16" sourceRef="Task_Custody_GuardSign" targetRef="Event_Custody_Respond"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Custody">
    <bpmndi:BPMNPlane id="BPMNPlane_Custody" bpmnElement="Process_Custody">
      <bpmndi:BPMNShape id="Shape_Lane_Custody_Operator" bpmnElement="Lane_Custody_Operator" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="1180" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Custody_Guardian" bpmnElement="Lane_Custody_Guardian" isHorizontal="true">
        <dc:Bounds x="30" y="250" width="1180" height="230"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Custody_Start" bpmnElement="Event_Custody_Start"><dc:Bounds x="60" y="110" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Hash" bpmnElement="Task_Custody_Hash"><dc:Bounds x="150" y="98" width="160" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_OpSig" bpmnElement="Task_Custody_OpSig"><dc:Bounds x="360" y="98" width="170" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Collect" bpmnElement="Task_Custody_Collect"><dc:Bounds x="580" y="98" width="180" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Quorum" bpmnElement="Gateway_Custody_Quorum" isMarkerVisible="true"><dc:Bounds x="810" y="103" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Assemble" bpmnElement="Task_Custody_Assemble"><dc:Bounds x="910" y="98" width="190" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Work" bpmnElement="Task_Custody_Work"><dc:Bounds x="150" y="180" width="160" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Broadcast" bpmnElement="Task_Custody_Broadcast"><dc:Bounds x="360" y="180" width="160" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Done" bpmnElement="Event_Custody_Done"><dc:Bounds x="580" y="187" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_NoQuorum" bpmnElement="Event_Custody_NoQuorum"><dc:Bounds x="830" y="185" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Custody_Recv" bpmnElement="Event_Custody_Recv"><dc:Bounds x="60" y="340" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Auth" bpmnElement="Task_Custody_Auth"><dc:Bounds x="150" y="328" width="170" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Replay" bpmnElement="Task_Custody_Replay"><dc:Bounds x="370" y="328" width="170" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Guard" bpmnElement="Task_Custody_Guard"><dc:Bounds x="590" y="328" width="170" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Balance" bpmnElement="Task_Custody_Balance"><dc:Bounds x="810" y="328" width="170" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Rehash" bpmnElement="Task_Custody_Rehash"><dc:Bounds x="370" y="420" width="190" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_GuardSign" bpmnElement="Task_Custody_GuardSign"><dc:Bounds x="610" y="420" width="190" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Custody_Respond" bpmnElement="Event_Custody_Respond"><dc:Bounds x="860" y="427" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Custody_1" bpmnElement="Flow_Custody_1"><di:waypoint x="96" y="128"/><di:waypoint x="150" y="128"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_2" bpmnElement="Flow_Custody_2"><di:waypoint x="310" y="128"/><di:waypoint x="360" y="128"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_3" bpmnElement="Flow_Custody_3"><di:waypoint x="530" y="128"/><di:waypoint x="580" y="128"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_4" bpmnElement="Flow_Custody_4"><di:waypoint x="760" y="128"/><di:waypoint x="810" y="128"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_5" bpmnElement="Flow_Custody_5"><di:waypoint x="860" y="128"/><di:waypoint x="910" y="128"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_6" bpmnElement="Flow_Custody_6"><di:waypoint x="835" y="153"/><di:waypoint x="848" y="185"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_7" bpmnElement="Flow_Custody_7"><di:waypoint x="1005" y="158"/><di:waypoint x="230" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_8" bpmnElement="Flow_Custody_8"><di:waypoint x="310" y="205"/><di:waypoint x="360" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_9" bpmnElement="Flow_Custody_9"><di:waypoint x="520" y="205"/><di:waypoint x="580" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_10" bpmnElement="Flow_Custody_10"><di:waypoint x="96" y="358"/><di:waypoint x="150" y="358"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_11" bpmnElement="Flow_Custody_11"><di:waypoint x="320" y="358"/><di:waypoint x="370" y="358"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_12" bpmnElement="Flow_Custody_12"><di:waypoint x="540" y="358"/><di:waypoint x="590" y="358"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_13" bpmnElement="Flow_Custody_13"><di:waypoint x="760" y="358"/><di:waypoint x="810" y="358"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_14" bpmnElement="Flow_Custody_14"><di:waypoint x="895" y="388"/><di:waypoint x="465" y="420"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_15" bpmnElement="Flow_Custody_15"><di:waypoint x="560" y="445"/><di:waypoint x="610" y="445"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Custody_16" bpmnElement="Flow_Custody_16"><di:waypoint x="800" y="445"/><di:waypoint x="860" y="445"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>