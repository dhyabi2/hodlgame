<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_holdfun_all"
  targetNamespace="https://holdfun.io/bpmn">

  <!-- GENERATED by build-all.mjs from 00-overview.bpmn, 01-launch.bpmn, 02-buy.bpmn, 03-sell.bpmn, 04-staking.bpmn, 05-indexer-replay.bpmn, 06-custody.bpmn, 07-settlement.bpmn, 08-fragment-links.bpmn, 09-metadata-authority.bpmn, 10-discovery.bpmn, 11-verify.bpmn — do not edit by hand. -->

  <!-- ════════ from 00-overview.bpmn ════════ -->

<bpmn:process id="Process_Overview" name="HoldFun end-to-end (chain-only data flow)" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Ov">
      <bpmn:lane id="Lane_Ov_User" name="User wallet (browser, own keys)">
        <bpmn:flowNodeRef>Event_Ov_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ov_Hello</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ov_Ops</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ov_Indexer" name="Indexer (ANYONE — zero secrets)">
        <bpmn:flowNodeRef>Task_Ov_Discover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ov_Fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ov_Replay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ov_Root</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ov_Served</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ov_Settle" name="Settlement (custody key holder)">
        <bpmn:flowNodeRef>Task_Ov_Settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ov_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Ov_Start" name="user acts">
      <bpmn:outgoing>Flow_Ov_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Ov_Hello" name="one-time hello: 1-raw send to ANCHOR (self-registration)">
      <bpmn:documentation>core/anchor.ts — discovery needs no operator list. Pools hello too, with tokenId in the representative.</bpmn:documentation>
      <bpmn:incoming>Flow_Ov_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ov_Ops" name="ops as signed blocks: compact links, fragment pairs, chained deposits">
      <bpmn:documentation>Value binds via previous→deposit chaining; big payloads ride two chained blocks (core/fraglink.ts). Metadata/comments are HTTP but author-SIGNED (core/metaAuth.ts, core/commentAuth.ts); freezes/transfers are anchored on-chain (core/metaAnchor.ts).</bpmn:documentation>
      <bpmn:incoming>Flow_Ov_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ov_Discover" name="discoverAccounts(ANCHOR): 2-hop participant set">
      <bpmn:incoming>Flow_Ov_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ov_Fetch" name="fetch chains via rpc.nano.to (primary; nano-gpt keyless fallback); verifyFetchedBlock (hash + signature)">
      <bpmn:documentation>lib/rpc.ts + indexer/blockSource.ts — untrusted endpoints can omit, never forge.</bpmn:documentation>
      <bpmn:incoming>Flow_Ov_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ov_Replay" name="decode (fragments, anchors) → derive pools → value-bind → replayMulti">
      <bpmn:documentation>indexer/multiIndexer.ts — two-pass: pool pubkeys come from the first creator seed deposit's link, then ops fold through the pure state machine.</bpmn:documentation>
      <bpmn:incoming>Flow_Ov_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ov_Root" name="stateRoot(state) — anyone recomputes and compares">
      <bpmn:documentation>core/canonical.ts + scripts/verify.ts — byte-identical for every honest replayer.</bpmn:documentation>
      <bpmn:incoming>Flow_Ov_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ov_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Ov_Served" name="market + explorer served / verified">
      <bpmn:incoming>Flow_Ov_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Ov_Settle" name="settlePoolNetted: pay max(0, entitlement − alreadySent) per recipient">
      <bpmn:documentation>server/settled.ts + sweep.ts — alreadySent read from the pool's own chain; exactly-once without a database; N concurrent sweepers converge.</bpmn:documentation>
      <bpmn:incoming>Flow_Ov_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Ov_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Ov_Paid" name="sellers paid, rejects refunded">
      <bpmn:incoming>Flow_Ov_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Ov_1" sourceRef="Event_Ov_Start" targetRef="Task_Ov_Hello"/>
    <bpmn:sequenceFlow id="Flow_Ov_2" sourceRef="Task_Ov_Hello" targetRef="Task_Ov_Ops"/>
    <bpmn:sequenceFlow id="Flow_Ov_3" sourceRef="Task_Ov_Ops" targetRef="Task_Ov_Discover"/>
    <bpmn:sequenceFlow id="Flow_Ov_4" sourceRef="Task_Ov_Discover" targetRef="Task_Ov_Fetch"/>
    <bpmn:sequenceFlow id="Flow_Ov_5" sourceRef="Task_Ov_Fetch" targetRef="Task_Ov_Replay"/>
    <bpmn:sequenceFlow id="Flow_Ov_6" sourceRef="Task_Ov_Replay" targetRef="Task_Ov_Root"/>
    <bpmn:sequenceFlow id="Flow_Ov_7" sourceRef="Task_Ov_Root" targetRef="Event_Ov_Served"/>
    <bpmn:sequenceFlow id="Flow_Ov_8" sourceRef="Task_Ov_Root" targetRef="Task_Ov_Settle" name="obligations due"/>
    <bpmn:sequenceFlow id="Flow_Ov_9" sourceRef="Task_Ov_Settle" targetRef="Event_Ov_Paid"/>

  </bpmn:process>

  <!-- ════════ from 01-launch.bpmn ════════ -->

<bpmn:process id="Process_Launch" name="Token launch" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Launch">
      <bpmn:lane id="Lane_Launch_Creator" name="Creator (browser wallet)">
        <bpmn:flowNodeRef>Event_Launch_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch_Hello</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch_Block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch_TokenId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch_SignMeta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Launch_Server" name="Registry (verifies, never trusts)">
        <bpmn:flowNodeRef>Task_Launch_VerifyMeta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Launch_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Launch_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Launch_Start" name="creator submits form">
      <bpmn:outgoing>Flow_Launch_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Launch_Hello" name="ensureHello(): 1-raw send to ANCHOR (once per account)">
      <bpmn:documentation>Registers the creator for trustless discovery (10-discovery.bpmn). Best-effort; never blocks the op.</bpmn:documentation>
      <bpmn:incoming>Flow_Launch_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Launch_Block" name="submitBlock(encodeOpLink('', launch), 1 raw)">
      <bpmn:documentation>link = [0x01][zero tokenId][supply]. The 1-raw amount marks a data block. State machine mints floor(supply*5%) to the creator and the rest to treasury.</bpmn:documentation>
      <bpmn:incoming>Flow_Launch_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Launch_TokenId" name="tokenId = tokenIdFromLaunchHash(blockHash)">
      <bpmn:documentation>Identity without a registry: first 128 bits of the launch block's hash.</bpmn:documentation>
      <bpmn:incoming>Flow_Launch_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Launch_SignMeta" name="sign metaSignDigest(tokenId, seq, 'update', metaFieldsHash(sanitized))">
      <bpmn:documentation>core/metaAuth.ts — the creator signs the SANITIZED fields with the launch key; POST { fields, account, signature, seq } to /api/tokens.</bpmn:documentation>
      <bpmn:incoming>Flow_Launch_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Launch_VerifyMeta" name="verifyMetaSignature + gateMetaAction + decideMetaUpdate">
      <bpmn:documentation>server/metaAuth.ts — authority = the on-chain launch signer (provisional first-writer only until the launch indexes, then the creator overrides and the row locks). Chain-derived authority state (anchors) gates freezes/transfers.</bpmn:documentation>
      <bpmn:incoming>Flow_Launch_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Launch_Store" name="saveMetaRow(tokenId, sanitized, authorityRow)">
      <bpmn:documentation>Image stored as ipfs://CID (host-independent; anyone can re-pin).</bpmn:documentation>
      <bpmn:incoming>Flow_Launch_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Launch_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Launch_Done" name="token live">
      <bpmn:incoming>Flow_Launch_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Launch_1" sourceRef="Event_Launch_Start" targetRef="Task_Launch_Hello"/>
    <bpmn:sequenceFlow id="Flow_Launch_2" sourceRef="Task_Launch_Hello" targetRef="Task_Launch_Block"/>
    <bpmn:sequenceFlow id="Flow_Launch_3" sourceRef="Task_Launch_Block" targetRef="Task_Launch_TokenId"/>
    <bpmn:sequenceFlow id="Flow_Launch_4" sourceRef="Task_Launch_TokenId" targetRef="Task_Launch_SignMeta"/>
    <bpmn:sequenceFlow id="Flow_Launch_5" sourceRef="Task_Launch_SignMeta" targetRef="Task_Launch_VerifyMeta"/>
    <bpmn:sequenceFlow id="Flow_Launch_6" sourceRef="Task_Launch_VerifyMeta" targetRef="Task_Launch_Store"/>
    <bpmn:sequenceFlow id="Flow_Launch_7" sourceRef="Task_Launch_Store" targetRef="Event_Launch_Done"/>

  </bpmn:process>

  <!-- ════════ from 02-buy.bpmn ════════ -->

<bpmn:process id="Process_Buy" name="Value-bound buy / seed" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Buy">
      <bpmn:lane id="Lane_Buy_User" name="Buyer (or creator, when seeding)">
        <bpmn:flowNodeRef>Event_Buy_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Deposit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Op</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buy_Indexer" name="Indexer (deterministic)">
        <bpmn:flowNodeRef>Task_Buy_Chain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Buy_Routes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Buy_Credited</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Buy_Skipped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Buy_Start" name="buy / seed intent">
      <bpmn:outgoing>Flow_Buy_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Buy_Deposit" name="send XNO to pool account (native amount = the value)">
      <bpmn:incoming>Flow_Buy_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Buy_Op" name="1-raw op block, previous = deposit hash (buy: minTokens; seed: tokens)">
      <bpmn:documentation>encodeOpLink — buy carries only the slippage guard; seedLiq/addLiq carry only the token leg. xno is NEVER declared.</bpmn:documentation>
      <bpmn:incoming>Flow_Buy_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Buy_Chain" name="collectEvents: dep = byHash(op.previous)">
      <bpmn:incoming>Flow_Buy_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Buy_Routes" name="dep.link == poolOf(tokenId) and amount &gt; 0?">
      <bpmn:documentation>poolOf = chain-derived (derivePoolKeysFromChain) with custody resolver as bootstrap fallback.</bpmn:documentation>
      <bpmn:incoming>Flow_Buy_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Buy_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Buy_Bind" name="op.xno := deposit native amount (authoritative)">
      <bpmn:incoming>Flow_Buy_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Buy_Apply" name="applyBlock: constantProductOut (1% fee) / seed pool">
      <bpmn:documentation>Slippage guard: tokens-out &lt; minTokens throws → op invalid → deposit later refunded by netted settlement (07).</bpmn:documentation>
      <bpmn:incoming>Flow_Buy_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Buy_Credited" name="credited">
      <bpmn:incoming>Flow_Buy_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="Event_Buy_Skipped" name="skipped (unbacked / misrouted)">
      <bpmn:incoming>Flow_Buy_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Buy_1" sourceRef="Event_Buy_Start" targetRef="Task_Buy_Deposit"/>
    <bpmn:sequenceFlow id="Flow_Buy_2" sourceRef="Task_Buy_Deposit" targetRef="Task_Buy_Op"/>
    <bpmn:sequenceFlow id="Flow_Buy_3" sourceRef="Task_Buy_Op" targetRef="Task_Buy_Chain"/>
    <bpmn:sequenceFlow id="Flow_Buy_4" sourceRef="Task_Buy_Chain" targetRef="Gateway_Buy_Routes"/>
    <bpmn:sequenceFlow id="Flow_Buy_5" sourceRef="Gateway_Buy_Routes" targetRef="Task_Buy_Bind" name="yes"/>
    <bpmn:sequenceFlow id="Flow_Buy_6" sourceRef="Gateway_Buy_Routes" targetRef="Event_Buy_Skipped" name="no"/>
    <bpmn:sequenceFlow id="Flow_Buy_7" sourceRef="Task_Buy_Bind" targetRef="Task_Buy_Apply"/>
    <bpmn:sequenceFlow id="Flow_Buy_8" sourceRef="Task_Buy_Apply" targetRef="Event_Buy_Credited"/>

  </bpmn:process>

  <!-- ════════ from 03-sell.bpmn ════════ -->

<bpmn:process id="Process_Sell" name="Sell + netted payout" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Sell">
      <bpmn:lane id="Lane_Sell_User" name="Seller">
        <bpmn:flowNodeRef>Event_Sell_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sell_Slip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sell_Compact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sell_Frag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sell_System" name="Indexer + settlement">
        <bpmn:flowNodeRef>Task_Sell_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sell_Entitle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sell_Net</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Sell_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Sell_Start" name="seller sells tokens">
      <bpmn:outgoing>Flow_Sell_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_Sell_Slip" name="slippage guard?">
      <bpmn:incoming>Flow_Sell_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Sell_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sell_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Sell_Compact" name="compact link: [0x04][tokenId][tokens] (minXno = 0)">
      <bpmn:incoming>Flow_Sell_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Sell_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Sell_Frag" name="encodeFragLinks(sell{tokens, minXno}) → two chained 1-raw blocks">
      <bpmn:documentation>core/fraglink.ts — frag A: [0xE4][tokenId][body 0..15); frag B (previous = A): body[15..47). Payload fully on-chain.</bpmn:documentation>
      <bpmn:incoming>Flow_Sell_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Sell_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Sell_Apply" name="applyBlock: xnoOut = constantProductOut; minXno throws on slippage">
      <bpmn:documentation>Invalid sells change nothing and are listed with their reason (explorer A5).</bpmn:documentation>
      <bpmn:incoming>Flow_Sell_4</bpmn:incoming>
      <bpmn:incoming>Flow_Sell_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Sell_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Sell_Entitle" name="analyze → sellPayouts: exact XNO-out at execution point">
      <bpmn:documentation>server/analytics.ts — the entitlement is a pure function of replay; every honest indexer computes the same number.</bpmn:documentation>
      <bpmn:incoming>Flow_Sell_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Sell_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Sell_Net" name="settlePoolNetted: pay max(0, entitlement − alreadySent)">
      <bpmn:documentation>server/settled.ts — alreadySent from the pool's own outgoing sends; obligations deterministically ordered so concurrent sweepers build identical blocks.</bpmn:documentation>
      <bpmn:incoming>Flow_Sell_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Sell_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Sell_Paid" name="seller paid in XNO">
      <bpmn:incoming>Flow_Sell_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Sell_1" sourceRef="Event_Sell_Start" targetRef="Gateway_Sell_Slip"/>
    <bpmn:sequenceFlow id="Flow_Sell_2" sourceRef="Gateway_Sell_Slip" targetRef="Task_Sell_Compact" name="no"/>
    <bpmn:sequenceFlow id="Flow_Sell_3" sourceRef="Gateway_Sell_Slip" targetRef="Task_Sell_Frag" name="yes (minXno &gt; 0)"/>
    <bpmn:sequenceFlow id="Flow_Sell_4" sourceRef="Task_Sell_Compact" targetRef="Task_Sell_Apply"/>
    <bpmn:sequenceFlow id="Flow_Sell_5" sourceRef="Task_Sell_Frag" targetRef="Task_Sell_Apply"/>
    <bpmn:sequenceFlow id="Flow_Sell_6" sourceRef="Task_Sell_Apply" targetRef="Task_Sell_Entitle"/>
    <bpmn:sequenceFlow id="Flow_Sell_7" sourceRef="Task_Sell_Entitle" targetRef="Task_Sell_Net"/>
    <bpmn:sequenceFlow id="Flow_Sell_8" sourceRef="Task_Sell_Net" targetRef="Event_Sell_Paid"/>

  </bpmn:process>

  <!-- ════════ from 04-staking.bpmn ════════ -->

<bpmn:process id="Process_Staking" name="Stake / unstake / claim" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Staking">
      <bpmn:lane id="Lane_Staking_User" name="Holder">
        <bpmn:flowNodeRef>Event_Stake_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stake_Which</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stake_Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Unstake_Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Claim_Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Stake_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Staking_Indexer" name="Indexer (applyOp)">
        <bpmn:flowNodeRef>Gateway_Stake_Kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stake_ApplyStake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stake_ApplyUnstake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stake_ApplyClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Stake_IdxDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- User -->
    <bpmn:startEvent id="Event_Stake_Start" name="Holder signs an op">
      <bpmn:outgoing>Flow_Stake_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_Stake_Which" name="which op?">
      <bpmn:incoming>Flow_Stake_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stake_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stake_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Stake_Sign" name="stake op (link = tokenId|amount)">
      <bpmn:incoming>Flow_Stake_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Unstake_Sign" name="unstake op (link = tokenId|amount)">
      <bpmn:incoming>Flow_Stake_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Claim_Sign" name="claim op (link = tokenId)">
      <bpmn:incoming>Flow_Stake_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Stake_Done" name="Broadcasted">
      <bpmn:incoming>Flow_Stake_5</bpmn:incoming>
      <bpmn:incoming>Flow_Stake_6</bpmn:incoming>
      <bpmn:incoming>Flow_Stake_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_8</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Indexer -->
    <bpmn:exclusiveGateway id="Gateway_Stake_Kind" name="op kind">
      <bpmn:incoming>Flow_Stake_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stake_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_Stake_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Stake_ApplyStake" name="stake: settlePoints() → staked += amount">
      <bpmn:documentation>accrue(s,h) + settlePoints(s, sender, h) settle the debt before moving stake.</bpmn:documentation>
      <bpmn:incoming>Flow_Stake_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Stake_ApplyUnstake" name="unstake: tax 20% → burn 5% + rebate 15% + user 80%">
      <bpmn:documentation>supply -= burn (deflation); rebateVault += rebate; syncRewards(s, rebate).</bpmn:documentation>
      <bpmn:incoming>Flow_Stake_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_13</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Stake_ApplyClaim" name="claim: pending = points·rewardPerPoint/PRECISION − rewardDebt">
      <bpmn:documentation>Pay from rebateVault (clamped to available); carry shortfall via debt.</bpmn:documentation>
      <bpmn:incoming>Flow_Stake_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Stake_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Stake_IdxDone" name="state updated">
      <bpmn:incoming>Flow_Stake_12</bpmn:incoming>
      <bpmn:incoming>Flow_Stake_13</bpmn:incoming>
      <bpmn:incoming>Flow_Stake_14</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Stake_1" sourceRef="Event_Stake_Start" targetRef="Gateway_Stake_Which"/>
    <bpmn:sequenceFlow id="Flow_Stake_2" sourceRef="Gateway_Stake_Which" targetRef="Task_Stake_Sign" name="stake"/>
    <bpmn:sequenceFlow id="Flow_Stake_3" sourceRef="Gateway_Stake_Which" targetRef="Task_Unstake_Sign" name="unstake"/>
    <bpmn:sequenceFlow id="Flow_Stake_4" sourceRef="Gateway_Stake_Which" targetRef="Task_Claim_Sign" name="claim"/>
    <bpmn:sequenceFlow id="Flow_Stake_5" sourceRef="Task_Stake_Sign" targetRef="Event_Stake_Done"/>
    <bpmn:sequenceFlow id="Flow_Stake_6" sourceRef="Task_Unstake_Sign" targetRef="Event_Stake_Done"/>
    <bpmn:sequenceFlow id="Flow_Stake_7" sourceRef="Task_Claim_Sign" targetRef="Event_Stake_Done"/>
    <bpmn:sequenceFlow id="Flow_Stake_8" sourceRef="Event_Stake_Done" targetRef="Gateway_Stake_Kind"/>
    <bpmn:sequenceFlow id="Flow_Stake_9" sourceRef="Gateway_Stake_Kind" targetRef="Task_Stake_ApplyStake" name="stake"/>
    <bpmn:sequenceFlow id="Flow_Stake_10" sourceRef="Gateway_Stake_Kind" targetRef="Task_Stake_ApplyUnstake" name="unstake"/>
    <bpmn:sequenceFlow id="Flow_Stake_11" sourceRef="Gateway_Stake_Kind" targetRef="Task_Stake_ApplyClaim" name="claim"/>
    <bpmn:sequenceFlow id="Flow_Stake_12" sourceRef="Task_Stake_ApplyStake" targetRef="Event_Stake_IdxDone"/>
    <bpmn:sequenceFlow id="Flow_Stake_13" sourceRef="Task_Stake_ApplyUnstake" targetRef="Event_Stake_IdxDone"/>
    <bpmn:sequenceFlow id="Flow_Stake_14" sourceRef="Task_Stake_ApplyClaim" targetRef="Event_Stake_IdxDone"/>

  </bpmn:process>

  <!-- ════════ from 05-indexer-replay.bpmn ════════ -->

<bpmn:process id="Process_Replay" name="Indexer replay (secretless)" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Replay">
      <bpmn:lane id="Lane_Replay_All" name="Any indexer (operator, verifier, browser)">
        <bpmn:flowNodeRef>Event_Replay_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Discover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Decode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Pools</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Fold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Replay_Root</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Replay_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Replay_Start" name="sync">
      <bpmn:outgoing>Flow_Replay_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Replay_Discover" name="discoverAccounts(ANCHOR) — 2-hop participant set">
      <bpmn:documentation>indexer/discovery.ts (10-discovery.bpmn). WATCHED_ACCOUNTS env is only an additive migration fallback.</bpmn:documentation>
      <bpmn:incoming>Flow_Replay_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Replay_Fetch" name="listBlocks via rpc.nano.to (primary; rpc.nano-gpt.com keyless fallback); verifyFetchedBlock each">
      <bpmn:documentation>lib/rpc.ts (rpc.nano.to primary + keyed; rpc.nano-gpt.com is the sole permitted keyless fallback for reads/process; work falls back to LOCAL CPU) + blockSource.ts (recompute hash, check ed25519-blake2b signature; value-bearing failures rejected, valueless epoch blocks tolerated).</bpmn:documentation>
      <bpmn:incoming>Flow_Replay_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Replay_Decode" name="decodeChain: compact links, commit links (legacy), FRAGMENT joins, meta anchors">
      <bpmn:documentation>Fragment B blocks are consumed by their A (never mis-decoded standalone); dangling A's deterministically ignored; makeImmutable/setAuthority anchors collected (core/metaAnchor.ts).</bpmn:documentation>
      <bpmn:incoming>Flow_Replay_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Replay_Pools" name="derivePoolKeysFromChain (pass 1): pool = first creator seed deposit's link">
      <bpmn:documentation>First-wins in canonical order; only creator-signed seeds count. This removes the last private replay input — POOL_SEED signs payouts, never validates history.</bpmn:documentation>
      <bpmn:incoming>Flow_Replay_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Replay_Bind" name="value-bind (pass 2): buy/seed xno := chained deposit's native amount">
      <bpmn:incoming>Flow_Replay_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Replay_Fold" name="sort canonicalOrder(height, hash) → replayMulti (invalid ops flagged with reasons)">
      <bpmn:incoming>Flow_Replay_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Replay_Root" name="stateRoot(state) — consensus fields only, metadata-independent">
      <bpmn:documentation>core/canonical.ts. Served at /root; recomputable by anyone (11-verify.bpmn). The explorer additionally derives per-op deltas from the same fold (server/explorer.ts).</bpmn:documentation>
      <bpmn:incoming>Flow_Replay_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Replay_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Replay_Done" name="byte-identical state">
      <bpmn:incoming>Flow_Replay_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Replay_1" sourceRef="Event_Replay_Start" targetRef="Task_Replay_Discover"/>
    <bpmn:sequenceFlow id="Flow_Replay_2" sourceRef="Task_Replay_Discover" targetRef="Task_Replay_Fetch"/>
    <bpmn:sequenceFlow id="Flow_Replay_3" sourceRef="Task_Replay_Fetch" targetRef="Task_Replay_Decode"/>
    <bpmn:sequenceFlow id="Flow_Replay_4" sourceRef="Task_Replay_Decode" targetRef="Task_Replay_Pools"/>
    <bpmn:sequenceFlow id="Flow_Replay_5" sourceRef="Task_Replay_Pools" targetRef="Task_Replay_Bind"/>
    <bpmn:sequenceFlow id="Flow_Replay_6" sourceRef="Task_Replay_Bind" targetRef="Task_Replay_Fold"/>
    <bpmn:sequenceFlow id="Flow_Replay_7" sourceRef="Task_Replay_Fold" targetRef="Task_Replay_Root"/>
    <bpmn:sequenceFlow id="Flow_Replay_8" sourceRef="Task_Replay_Root" targetRef="Event_Replay_Done"/>

  </bpmn:process>

  <!-- ════════ from 06-custody.bpmn ════════ -->

<bpmn:process id="Process_Custody" name="Payout custody (today + FROST target)" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Cust">
      <bpmn:lane id="Lane_Cust_Sweeper" name="Sweeper (proposes payouts)">
        <bpmn:flowNodeRef>Event_Cust_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cust_Assert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cust_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cust_Mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cust_Single</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cust_Broadcast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Cust_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cust_Signers" name="FROST signers (roadmap: any 2 of 3)">
        <bpmn:flowNodeRef>Task_Cust_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cust_Frost</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Cust_Start" name="obligations due">
      <bpmn:outgoing>Flow_Cust_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Cust_Assert" name="assert chainDerivedPool(tokenId) == custodyPool(tokenId); skip mismatches">
      <bpmn:documentation>server/operator.ts — a creator who seeded a self-controlled "pool" gets a deterministic ledger but no custody service (and a UI flag).</bpmn:documentation>
      <bpmn:incoming>Flow_Cust_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Cust_Build" name="build payout block: canonical obligation order, frontier-chained">
      <bpmn:documentation>Deterministic construction → concurrent sweepers propose IDENTICAL blocks (duplicate process is a no-op).</bpmn:documentation>
      <bpmn:incoming>Flow_Cust_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Cust_Mode" name="custody mode">
      <bpmn:incoming>Flow_Cust_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cust_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Cust_Single" name="TODAY: signPayout (pool key; optional guardian policy approval first)">
      <bpmn:documentation>server/custody.ts + guardian.ts — the guardian re-verifies target/amount and can refuse, but the pool key alone is cryptographically sufficient. Loss bounded by planned hot/cold caps.</bpmn:documentation>
      <bpmn:incoming>Flow_Cust_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Cust_Verify" name="ROADMAP: each signer re-derives the payout from ITS OWN replay">
      <bpmn:documentation>Cosigner-as-verifier (BlackBird/VELA pattern): settlement is deterministic (07), so a signer recomputes entitlement − alreadySent itself and refuses anything else. Threshold signing splits the key; this check stops a compromised coordinator.</bpmn:documentation>
      <bpmn:incoming>Flow_Cust_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Cust_Frost" name="ROADMAP: blake2b-FROST 2-of-3 → ONE aggregate signature valid on-chain">
      <bpmn:documentation>Dealerless DKG (key never assembled); RFC 9591 with BLAKE2b-512 challenge matching Nano's verifier; production-proven in BlackBird/VELA.</bpmn:documentation>
      <bpmn:incoming>Flow_Cust_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Cust_Broadcast" name="broadcastPayout (rpc process)">
      <bpmn:incoming>Flow_Cust_6</bpmn:incoming>
      <bpmn:incoming>Flow_Cust_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_9</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Cust_Done" name="payout on-chain">
      <bpmn:incoming>Flow_Cust_9</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Cust_1" sourceRef="Event_Cust_Start" targetRef="Task_Cust_Assert"/>
    <bpmn:sequenceFlow id="Flow_Cust_2" sourceRef="Task_Cust_Assert" targetRef="Task_Cust_Build"/>
    <bpmn:sequenceFlow id="Flow_Cust_3" sourceRef="Task_Cust_Build" targetRef="Gateway_Cust_Mode"/>
    <bpmn:sequenceFlow id="Flow_Cust_4" sourceRef="Gateway_Cust_Mode" targetRef="Task_Cust_Single" name="today"/>
    <bpmn:sequenceFlow id="Flow_Cust_5" sourceRef="Gateway_Cust_Mode" targetRef="Task_Cust_Verify" name="FROST (W1)"/>
    <bpmn:sequenceFlow id="Flow_Cust_6" sourceRef="Task_Cust_Single" targetRef="Task_Cust_Broadcast"/>
    <bpmn:sequenceFlow id="Flow_Cust_7" sourceRef="Task_Cust_Verify" targetRef="Task_Cust_Frost"/>
    <bpmn:sequenceFlow id="Flow_Cust_8" sourceRef="Task_Cust_Frost" targetRef="Task_Cust_Broadcast"/>
    <bpmn:sequenceFlow id="Flow_Cust_9" sourceRef="Task_Cust_Broadcast" targetRef="Event_Cust_Done"/>

  </bpmn:process>

  <!-- ════════ from 07-settlement.bpmn ════════ -->

<bpmn:process id="Process_Settle" name="Netted settlement" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Settle">
      <bpmn:lane id="Lane_Settle_Sweep" name="Any sweeper (cron / watchtower)">
        <bpmn:flowNodeRef>Event_Settle_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Chain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Deposits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Entitle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Net</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Settle_Owed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Settle_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Settle_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Settle_Start" name="sweep tick">
      <bpmn:outgoing>Flow_Settle_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Settle_Receive" name="receivePoolPending + ensurePoolHello (self-registers pool→tokenId)">
      <bpmn:incoming>Flow_Settle_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Settle_Chain" name="listBlocks(pool) — the pool's own chain IS the settlement ledger">
      <bpmn:incoming>Flow_Settle_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Settle_Deposits" name="readPoolDepositsFromChain: sender → Σ received (verified source blocks)">
      <bpmn:incoming>Flow_Settle_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Settle_Entitle" name="entitlementsFor: Σ sellPayouts + computeRefunds(received − credited)">
      <bpmn:documentation>server/settled.ts + reconcile.ts — a sender who never sent XNO has received 0 and can never drain the pool.</bpmn:documentation>
      <bpmn:incoming>Flow_Settle_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Settle_Sent" name="poolOutgoingByRecipient: alreadySent from the pool's sends">
      <bpmn:incoming>Flow_Settle_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Settle_Net" name="netObligations: owed = max(0, entitlement − sent), sorted by recipient">
      <bpmn:incoming>Flow_Settle_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Settle_Owed" name="anything owed?">
      <bpmn:incoming>Flow_Settle_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Settle_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Settle_Pay" name="settlePoolNetted: sign + broadcast sequentially (06-custody)">
      <bpmn:documentation>Balance-short or failed broadcasts stay owed and retry next sweep (queued, never lost, never doubled).</bpmn:documentation>
      <bpmn:incoming>Flow_Settle_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Settle_10</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Settle_Done" name="settled">
      <bpmn:incoming>Flow_Settle_9</bpmn:incoming>
      <bpmn:incoming>Flow_Settle_10</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Settle_1" sourceRef="Event_Settle_Start" targetRef="Task_Settle_Receive"/>
    <bpmn:sequenceFlow id="Flow_Settle_2" sourceRef="Task_Settle_Receive" targetRef="Task_Settle_Chain"/>
    <bpmn:sequenceFlow id="Flow_Settle_3" sourceRef="Task_Settle_Chain" targetRef="Task_Settle_Deposits"/>
    <bpmn:sequenceFlow id="Flow_Settle_4" sourceRef="Task_Settle_Deposits" targetRef="Task_Settle_Entitle"/>
    <bpmn:sequenceFlow id="Flow_Settle_5" sourceRef="Task_Settle_Entitle" targetRef="Task_Settle_Sent"/>
    <bpmn:sequenceFlow id="Flow_Settle_6" sourceRef="Task_Settle_Sent" targetRef="Task_Settle_Net"/>
    <bpmn:sequenceFlow id="Flow_Settle_7" sourceRef="Task_Settle_Net" targetRef="Gateway_Settle_Owed"/>
    <bpmn:sequenceFlow id="Flow_Settle_8" sourceRef="Gateway_Settle_Owed" targetRef="Task_Settle_Pay" name="yes"/>
    <bpmn:sequenceFlow id="Flow_Settle_9" sourceRef="Gateway_Settle_Owed" targetRef="Event_Settle_Done" name="no"/>
    <bpmn:sequenceFlow id="Flow_Settle_10" sourceRef="Task_Settle_Pay" targetRef="Event_Settle_Done"/>

  </bpmn:process>

  <!-- ════════ from 08-fragment-links.bpmn ════════ -->

<bpmn:process id="Process_Frag" name="Fragment links" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Frag">
      <bpmn:lane id="Lane_Frag_User" name="Sender wallet">
        <bpmn:flowNodeRef>Event_Frag_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Frag_Encode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Frag_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Frag_B</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Frag_Indexer" name="Indexer (deterministic join)">
        <bpmn:flowNodeRef>Task_Frag_Detect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Frag_Child</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Frag_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Frag_Applied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Frag_Wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Frag_Start" name="transfer / sell-with-minXno">
      <bpmn:outgoing>Flow_Frag_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Frag_Encode" name="encodeFragLinks(tokenId, op) → [linkA, linkB]">
      <bpmn:documentation>core/fraglink.ts — transfer body: toPub(32) ‖ amount(15); sell body: tokens(15) ‖ minXno(15) ‖ zero padding (enforced on decode).</bpmn:documentation>
      <bpmn:incoming>Flow_Frag_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Frag_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Frag_A" name="broadcast frag A (1-raw send, link = A)">
      <bpmn:incoming>Flow_Frag_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Frag_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Frag_B" name="broadcast frag B (1-raw send, previous = A.hash, link = B)">
      <bpmn:incoming>Flow_Frag_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Frag_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Frag_Detect" name="decodeChain: isFragA(link) on a 1-raw block">
      <bpmn:incoming>Flow_Frag_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Frag_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Frag_Child" name="valid chained child exists?">
      <bpmn:incoming>Flow_Frag_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Frag_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_Frag_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Frag_Join" name="assembleFrag(A.link, B.link); consume B; event height/hash = B">
      <bpmn:documentation>B is CONSUMED so its bytes are never mis-decoded as a standalone op. The op completes only at B → canonical ordering is identical for every indexer. Malformed pairs are deterministically ignored.</bpmn:documentation>
      <bpmn:incoming>Flow_Frag_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Frag_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Frag_Applied" name="op folds into state">
      <bpmn:incoming>Flow_Frag_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="Event_Frag_Wait" name="dangling A → ignored until B confirms">
      <bpmn:incoming>Flow_Frag_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Frag_1" sourceRef="Event_Frag_Start" targetRef="Task_Frag_Encode"/>
    <bpmn:sequenceFlow id="Flow_Frag_2" sourceRef="Task_Frag_Encode" targetRef="Task_Frag_A"/>
    <bpmn:sequenceFlow id="Flow_Frag_3" sourceRef="Task_Frag_A" targetRef="Task_Frag_B"/>
    <bpmn:sequenceFlow id="Flow_Frag_4" sourceRef="Task_Frag_B" targetRef="Task_Frag_Detect"/>
    <bpmn:sequenceFlow id="Flow_Frag_5" sourceRef="Task_Frag_Detect" targetRef="Gateway_Frag_Child"/>
    <bpmn:sequenceFlow id="Flow_Frag_6" sourceRef="Gateway_Frag_Child" targetRef="Task_Frag_Join" name="yes"/>
    <bpmn:sequenceFlow id="Flow_Frag_7" sourceRef="Gateway_Frag_Child" targetRef="Event_Frag_Wait" name="no"/>
    <bpmn:sequenceFlow id="Flow_Frag_8" sourceRef="Task_Frag_Join" targetRef="Event_Frag_Applied"/>

  </bpmn:process>

  <!-- ════════ from 09-metadata-authority.bpmn ════════ -->

<bpmn:process id="Process_Meta" name="Metadata authority" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Meta">
      <bpmn:lane id="Lane_Meta_Authority" name="Token authority (creator or transferee)">
        <bpmn:flowNodeRef>Event_Meta_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Meta_Action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meta_Anchor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meta_Sign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Meta_Server" name="Registry (chain state governs)">
        <bpmn:flowNodeRef>Task_Meta_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meta_Gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Meta_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Meta_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Meta_Start" name="metadata action">
      <bpmn:outgoing>Flow_Meta_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_Meta_Action" name="action kind">
      <bpmn:incoming>Flow_Meta_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Meta_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Meta_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Meta_Anchor" name="broadcast anchor: immutableAnchorLink / setAuthorityAnchorLinks (1-raw burns)">
      <bpmn:documentation>core/metaAnchor.ts — from the CURRENT authority's own account; anyone else's anchors are ignored by the fold.</bpmn:documentation>
      <bpmn:incoming>Flow_Meta_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Meta_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Meta_Sign" name="sign metaSignDigest(tokenId, seq, action, metaFieldsHash) → POST /api/tokens">
      <bpmn:incoming>Flow_Meta_3</bpmn:incoming>
      <bpmn:incoming>Flow_Meta_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Meta_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Meta_Verify" name="verifyMetaSignature (ed25519-blake2b vs claimed account)">
      <bpmn:incoming>Flow_Meta_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Meta_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Meta_Gate" name="gateMetaAction(action, authorityStateOf(tokenId))">
      <bpmn:documentation>Chain-derived state (deriveMetaAuthority fold) governs: frozen tokens reject writes (except the one-time freeze sync); freeze/transfer require their anchor on-chain FIRST.</bpmn:documentation>
      <bpmn:incoming>Flow_Meta_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Meta_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Meta_Decide" name="decideMetaUpdate: authority match, seq monotonic → saveMetaRow">
      <bpmn:documentation>Provisional first-writer only until the launch indexes; the on-chain creator overrides and the row locks.</bpmn:documentation>
      <bpmn:incoming>Flow_Meta_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Meta_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Meta_Done" name="registry synced (chain remains the truth)">
      <bpmn:incoming>Flow_Meta_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Meta_1" sourceRef="Event_Meta_Start" targetRef="Gateway_Meta_Action"/>
    <bpmn:sequenceFlow id="Flow_Meta_2" sourceRef="Gateway_Meta_Action" targetRef="Task_Meta_Anchor" name="makeImmutable / setAuthority"/>
    <bpmn:sequenceFlow id="Flow_Meta_3" sourceRef="Gateway_Meta_Action" targetRef="Task_Meta_Sign" name="update"/>
    <bpmn:sequenceFlow id="Flow_Meta_4" sourceRef="Task_Meta_Anchor" targetRef="Task_Meta_Sign"/>
    <bpmn:sequenceFlow id="Flow_Meta_5" sourceRef="Task_Meta_Sign" targetRef="Task_Meta_Verify"/>
    <bpmn:sequenceFlow id="Flow_Meta_6" sourceRef="Task_Meta_Verify" targetRef="Task_Meta_Gate"/>
    <bpmn:sequenceFlow id="Flow_Meta_7" sourceRef="Task_Meta_Gate" targetRef="Task_Meta_Decide"/>
    <bpmn:sequenceFlow id="Flow_Meta_8" sourceRef="Task_Meta_Decide" targetRef="Event_Meta_Done"/>

  </bpmn:process>

  <!-- ════════ from 10-discovery.bpmn ════════ -->

<bpmn:process id="Process_Disc" name="Anchor discovery" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Disc">
      <bpmn:lane id="Lane_Disc_Reg" name="Self-registration (users, pools)">
        <bpmn:flowNodeRef>Event_Disc_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disc_UserHello</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disc_PoolHello</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Disc_Indexer" name="Any indexer">
        <bpmn:flowNodeRef>Task_Disc_Hop1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disc_Partition</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disc_Hop2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Disc_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Disc_Start" name="first protocol use">
      <bpmn:outgoing>Flow_Disc_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Disc_UserHello" name="user: 1-raw send → ANCHOR (once; ensureHello in the client)">
      <bpmn:incoming>Flow_Disc_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Disc_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Disc_PoolHello" name="pool: 1-raw send → ANCHOR with representative = tokenId ‖ zeros">
      <bpmn:documentation>ensurePoolHello (sweep) — binds pool→token publicly without revealing any key.</bpmn:documentation>
      <bpmn:incoming>Flow_Disc_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Disc_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Disc_Hop1" name="hop 1: counterparties(ANCHOR) — confirmed receives + STILL-PENDING sends + outbound">
      <bpmn:documentation>A hello counts even if the anchor never pockets it; inbound senders come from verified source blocks only. Anchor OUTBOUND sends bootstrap legacy accounts (scripts/anchor-bootstrap.ts).</bpmn:documentation>
      <bpmn:incoming>Flow_Disc_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Disc_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Disc_Partition" name="partition: tokenIdFromHelloRep(rep) → pools; rest → users">
      <bpmn:incoming>Flow_Disc_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Disc_5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Disc_Hop2" name="hop 2: counterparties(each pool) → legacy buyers/sellers join users">
      <bpmn:documentation>Terminates here: op links decode to opcodes, never to further accounts. Deterministic → every indexer converges on the same sorted set.</bpmn:documentation>
      <bpmn:incoming>Flow_Disc_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Disc_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Disc_Done" name="participant set (users + pool→token map)">
      <bpmn:incoming>Flow_Disc_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Disc_1" sourceRef="Event_Disc_Start" targetRef="Task_Disc_UserHello"/>
    <bpmn:sequenceFlow id="Flow_Disc_2" sourceRef="Task_Disc_UserHello" targetRef="Task_Disc_PoolHello"/>
    <bpmn:sequenceFlow id="Flow_Disc_3" sourceRef="Task_Disc_PoolHello" targetRef="Task_Disc_Hop1"/>
    <bpmn:sequenceFlow id="Flow_Disc_4" sourceRef="Task_Disc_Hop1" targetRef="Task_Disc_Partition"/>
    <bpmn:sequenceFlow id="Flow_Disc_5" sourceRef="Task_Disc_Partition" targetRef="Task_Disc_Hop2"/>
    <bpmn:sequenceFlow id="Flow_Disc_6" sourceRef="Task_Disc_Hop2" targetRef="Event_Disc_Done"/>

  </bpmn:process>

  <!-- ════════ from 11-verify.bpmn ════════ -->

<bpmn:process id="Process_Verify" name="Verification &amp; snapshots" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Ver">
      <bpmn:lane id="Lane_Ver_Anyone" name="Any third party (verifier)">
        <bpmn:flowNodeRef>Event_Ver_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ver_Replay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ver_Root</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ver_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ver_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ver_Bad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ver_Operator" name="Operator (epoch snapshots)">
        <bpmn:flowNodeRef>Task_Ver_Snap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ver_Anchor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Ver_Mirrored</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Ver_Start" name="verify request">
      <bpmn:outgoing>Flow_Ver_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Ver_Replay" name="scripts/verify.ts: MultiIndexer with NO poolKey, NO secrets → full replay">
      <bpmn:documentation>Pools resolve from chain history (05); chain access via RPC failover with local block verification (any untrusted endpoint is safe for reads).</bpmn:documentation>
      <bpmn:incoming>Flow_Ver_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Ver_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ver_Root" name="stateRoot(state); fetch serving indexer's /root">
      <bpmn:incoming>Flow_Ver_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Ver_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Ver_Match" name="roots equal?">
      <bpmn:incoming>Flow_Ver_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Ver_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ver_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="Event_Ver_OK" name="VERIFIED — server proven honest">
      <bpmn:incoming>Flow_Ver_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="Event_Ver_Bad" name="MISMATCH — publicly falsifiable lie">
      <bpmn:incoming>Flow_Ver_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:serviceTask id="Task_Ver_Snap" name="exportSnapshot(): canonical JSON of residual off-chain state + blake2b hash">
      <bpmn:documentation>server/snapshot.ts — tokens/comments/commits/hellos; served read-only at /api/snapshot.</bpmn:documentation>
      <bpmn:outgoing>Flow_Ver_6</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Ver_Anchor" name="anchor: 1-raw send from ANCHOR to hash-as-pubkey (data burn)">
      <bpmn:documentation>scripts/snapshot.ts --anchor; verifySnapshotJson + isAnchored let anyone check a mirror against chain.</bpmn:documentation>
      <bpmn:incoming>Flow_Ver_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Ver_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Ver_Mirrored" name="mirrorable anywhere, verifiable on-chain">
      <bpmn:incoming>Flow_Ver_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Ver_1" sourceRef="Event_Ver_Start" targetRef="Task_Ver_Replay"/>
    <bpmn:sequenceFlow id="Flow_Ver_2" sourceRef="Task_Ver_Replay" targetRef="Task_Ver_Root"/>
    <bpmn:sequenceFlow id="Flow_Ver_3" sourceRef="Task_Ver_Root" targetRef="Gateway_Ver_Match"/>
    <bpmn:sequenceFlow id="Flow_Ver_4" sourceRef="Gateway_Ver_Match" targetRef="Event_Ver_OK" name="yes"/>
    <bpmn:sequenceFlow id="Flow_Ver_5" sourceRef="Gateway_Ver_Match" targetRef="Event_Ver_Bad" name="no"/>
    <bpmn:sequenceFlow id="Flow_Ver_6" sourceRef="Task_Ver_Snap" targetRef="Task_Ver_Anchor"/>
    <bpmn:sequenceFlow id="Flow_Ver_7" sourceRef="Task_Ver_Anchor" targetRef="Event_Ver_Mirrored"/>

  </bpmn:process>

<bpmndi:BPMNDiagram id="BPMNDiagram_Ov">
    <bpmndi:BPMNPlane id="BPMNPlane_Ov" bpmnElement="Process_Overview">
      <bpmndi:BPMNShape id="Shape_Lane_Ov_User" bpmnElement="Lane_Ov_User" isHorizontal="true"><dc:Bounds x="30" y="30" width="1240" height="150"/></bpmndi:BPMNShape>
