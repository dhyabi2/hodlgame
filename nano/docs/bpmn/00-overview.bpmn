<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_holdfun_overview"
  targetNamespace="https://holdfun.io/bpmn"
  exporter="manual"
  exporterVersion="1.0">

  <!-- ======================================================================
  HoldFun Nano L2 — Collaboration overview
  ======================================================================
  Shows the 5 actors and their message flows across the entire system.
  This is the "big picture" — each lane's activity is detailed in the
  flow-specific BPMN files.
  ====================================================================== -->

  <bpmn:collaboration id="Collab_holdfun" name="HoldFun Nano L2 (no smart contracts)">

    <!-- ===== Participants ===== -->

    <bpmn:participant id="Creator" name="Creator" processRef="Proc_Creator"/>
    <bpmn:participant id="Buyer" name="Buyer" processRef="Proc_Buyer"/>
    <bpmn:participant id="Seller" name="Seller" processRef="Proc_Seller"/>
    <bpmn:participant id="NanoNetwork" name="Nano Network" processRef="Proc_Nano"/>
    <bpmn:participant id="Operator" name="Operator (indexer + custody)" processRef="Proc_Operator"/>
    <bpmn:participant id="Guardian" name="Guardian (co-signer)" processRef="Proc_Guardian"/>

    <!-- ===== Message flows ===== -->

    <!-- Creator launches -->
    <bpmn:messageFlow id="MF_launch" sourceRef="Creator" targetRef="NanoNetwork"
      name="launch block (link = opcode|supply)"/>
    <bpmn:messageFlow id="MF_launch_meta" sourceRef="Creator" targetRef="Operator"
      name="commit-reveal payload (name, symbol, image, IPFS CID)"/>

    <!-- Buyer deposits -->
    <bpmn:messageFlow id="MF_deposit" sourceRef="Buyer" targetRef="NanoNetwork"
      name="native XNO send → pool account"/>
    <bpmn:messageFlow id="MF_buy_op" sourceRef="Buyer" targetRef="NanoNetwork"
      name="buy op block (previous = deposit hash, link = tokenId|minTokens)"/>

    <!-- Seller sells -->
    <bpmn:messageFlow id="MF_sell_op" sourceRef="Seller" targetRef="NanoNetwork"
      name="sell op block (link = tokenId|tokens)"/>
    <bpmn:messageFlow id="MF_sell_commit" sourceRef="Seller" targetRef="Operator"
      name="commit-reveal: sell with minXno"/>

    <!-- Operator reads Nano -->
    <bpmn:messageFlow id="MF_read" sourceRef="NanoNetwork" targetRef="Operator"
      name="account_history + blocks_info (read-only)"/>

    <!-- Operator → Guardian (co-sign payout) -->
    <bpmn:messageFlow id="MF_cosign" sourceRef="Operator" targetRef="Guardian"
      name="POST /sign { account, previous, balance, link, requestId }"/>
    <bpmn:messageFlow id="MF_cosign_resp" sourceRef="Guardian" targetRef="Operator"
      name="200 { signature, publicKey }"/>

    <!-- Operator pays seller -->
    <bpmn:messageFlow id="MF_payout" sourceRef="Operator" targetRef="NanoNetwork"
      name="pool → seller send (2-of-3 multisig)"/>

    <!-- Operator refunds rejected buys -->
    <bpmn:messageFlow id="MF_refund" sourceRef="Operator" targetRef="NanoNetwork"
      name="pool → buyer send (refund = received − credited)"/>

    <!-- Staker stakes/unstakes/claims -->
    <bpmn:messageFlow id="MF_stake" sourceRef="Seller" targetRef="NanoNetwork"
      name="stake/unstake/claim op blocks"/>

  </bpmn:collaboration>

  <!-- ===== Participant processes (stubs) ===== -->

  <bpmn:process id="Proc_Creator" name="Creator" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Creator" name="Creator">
        <bpmn:flowNodeRef>Event_CreatorStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_CreatorSign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CreatorDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_CreatorStart" name="Has token idea"/>
    <bpmn:serviceTask id="Service_CreatorSign" name="Sign launch block">
      <bpmn:incoming>Flow_Creator1</bpmn:incoming>
      <bpmn:outgoing>Flow_Creator2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_CreatorDone" name="Broadcasted"/>
    <bpmn:sequenceFlow id="Flow_Creator1" sourceRef="Event_CreatorStart" targetRef="Service_CreatorSign"/>
    <bpmn:sequenceFlow id="Flow_Creator2" sourceRef="Service_CreatorSign" targetRef="Event_CreatorDone"/>
  </bpmn:process>

  <bpmn:process id="Proc_Buyer" name="Buyer" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>Event_BuyerStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_BuyerDeposit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_BuyerSignOp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BuyerDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_BuyerStart" name="Wants tokens"/>
    <bpmn:serviceTask id="Service_BuyerDeposit" name="Send XNO to pool">
      <bpmn:incoming>Flow_Buyer1</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Service_BuyerSignOp" name="Sign buy op (previous = deposit hash)">
      <bpmn:incoming>Flow_Buyer2</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_BuyerDone" name="Confirmed"/>
    <bpmn:sequenceFlow id="Flow_Buyer1" sourceRef="Event_BuyerStart" targetRef="Service_BuyerDeposit"/>
    <bpmn:sequenceFlow id="Flow_Buyer2" sourceRef="Service_BuyerDeposit" targetRef="Service_BuyerSignOp"/>
    <bpmn:sequenceFlow id="Flow_Buyer3" sourceRef="Service_BuyerSignOp" targetRef="Event_BuyerDone"/>
  </bpmn:process>

  <bpmn:process id="Proc_Seller" name="Seller" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Seller" name="Seller">
        <bpmn:flowNodeRef>Event_SellerStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_SellerSignSell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_SellerDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_SellerStart" name="Wants XNO"/>
    <bpmn:serviceTask id="Service_SellerSignSell" name="Sign sell op (commit-reveal if minXno)">
      <bpmn:incoming>Flow_Seller1</bpmn:incoming>
      <bpmn:outgoing>Flow_Seller2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_SellerDone" name="Waiting for payout"/>
    <bpmn:sequenceFlow id="Flow_Seller1" sourceRef="Event_SellerStart" targetRef="Service_SellerSignSell"/>
    <bpmn:sequenceFlow id="Flow_Seller2" sourceRef="Service_SellerSignSell" targetRef="Event_SellerDone"/>
  </bpmn:process>

  <bpmn:process id="Proc_Nano" name="Nano Network" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Nano" name="Nano L1 (rpc.nano.to)">
        <bpmn:flowNodeRef>Service_NanoConfirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Service_NanoConfirm" name="Confirm blocks (ORV consensus, sub-second)"/>
  </bpmn:process>

  <bpmn:process id="Proc_Operator" name="Operator" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Operator" name="Operator (indexer + custody)">
        <bpmn:flowNodeRef>Service_OpIndex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OpReplay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OpReconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OpSweep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OpCosign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_OpRefund</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Service_OpIndex" name="Read blocks (NanoRpcSource.listBlocks)"/>
    <bpmn:serviceTask id="Service_OpReplay" name="Replay fold (replayMulti → applyBlock → applyOp)"/>
    <bpmn:serviceTask id="Service_OpReconcile" name="Reconcile (creditedBuys / computeRefunds)"/>
    <bpmn:serviceTask id="Service_OpSweep" name="Sweep (receivePoolsMulti / payoutSellsMulti)"/>
    <bpmn:serviceTask id="Service_OpCosign" name="Co-sign payouts (signPayoutWithSignatures / remoteCosign)"/>
    <bpmn:serviceTask id="Service_OpRefund" name="Refund rejected buys (refundRejectedBuys)"/>
  </bpmn:process>

  <bpmn:process id="Proc_Guardian" name="Guardian" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guardian" name="Guardian (independent co-signer)">
        <bpmn:flowNodeRef>Service_GuardianVerify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Service_GuardianSign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Service_GuardianVerify" name="Re-verify (guardian.ts: re-hash block, check balance, replay protection)"/>
    <bpmn:serviceTask id="Service_GuardianSign" name="Co-sign (signBlock with GUARDIAN_SEED)"/>
  </bpmn:process>

  <!-- ===== Diagram layout (minimal) ===== -->

  <bpmndi:BPMNDiagram id="BPMNDiagram_overview">
    <bpmndi:BPMNPlane id="BPMNPlane_overview" bpmnElement="Collab_holdfun">
      <!-- Participants -->
      <bpmndi:BPMNShape id="Shape_Creator" bpmnElement="Creator" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="1200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buyer" bpmnElement="Buyer" isHorizontal="true">
        <dc:Bounds x="30" y="120" width="1200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Seller" bpmnElement="Seller" isHorizontal="true">
        <dc:Bounds x="30" y="210" width="1200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Nano" bpmnElement="NanoNetwork" isHorizontal="true">
        <dc:Bounds x="30" y="300" width="1200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Operator" bpmnElement="Operator" isHorizontal="true">
        <dc:Bounds x="30" y="390" width="1200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Guardian" bpmnElement="Guardian" isHorizontal="true">
        <dc:Bounds x="30" y="480" width="1200" height="80"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>