<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_buy"
  targetNamespace="https://holdfun.io/bpmn">

  <!-- ======================================================================
  Flow 02 — Value-bound buy AND liquidity seed (same two-block pattern)
  ======================================================================
  A buy is TWO chained blocks: a native XNO send to the token's pool (the
  value) + a data block whose `previous` is that send (the intent). The
  indexer takes the deposit's NATIVE amount as the authoritative xno — any
  declared amount is dead weight; unbacked intents are skipped. Liquidity
  seeding (seedLiq/addLiq) uses the exact same pattern: the creator's compact
  op declares only `tokens`; the chained deposit binds the XNO. The FIRST
  creator-signed seed deposit also ANNOUNCES the pool: its link IS the pool
  pubkey, which is how any indexer resolves pools with zero secrets.
  ====================================================================== -->

  <bpmn:process id="Process_Buy" name="Value-bound buy / seed" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Buy">
      <bpmn:lane id="Lane_Buy_User" name="Buyer (or creator, when seeding)">
        <bpmn:flowNodeRef>Event_Buy_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Deposit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Op</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Buy_Indexer" name="Indexer (deterministic)">
        <bpmn:flowNodeRef>Task_Buy_Chain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Buy_Routes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Bind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Buy_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Buy_Credited</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Buy_Skipped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Event_Buy_Start" name="buy / seed intent">
      <bpmn:outgoing>Flow_Buy_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_Buy_Deposit" name="send XNO to pool account (native amount = the value)">
      <bpmn:incoming>Flow_Buy_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Buy_Op" name="1-raw op block, previous = deposit hash (buy: minTokens; seed: tokens)">
      <bpmn:documentation>encodeOpLink — buy carries only the slippage guard; seedLiq/addLiq carry only the token leg. xno is NEVER declared.</bpmn:documentation>
      <bpmn:incoming>Flow_Buy_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Buy_Chain" name="collectEvents: dep = byHash(op.previous)">
      <bpmn:incoming>Flow_Buy_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Buy_Routes" name="dep.link == poolOf(tokenId) and amount &gt; 0?">
      <bpmn:documentation>poolOf = chain-derived (derivePoolKeysFromChain) with custody resolver as bootstrap fallback.</bpmn:documentation>
      <bpmn:incoming>Flow_Buy_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_Buy_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Buy_Bind" name="op.xno := deposit native amount (authoritative)">
      <bpmn:incoming>Flow_Buy_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Buy_Apply" name="applyBlock: constantProductOut (1% fee) / seed pool">
      <bpmn:documentation>Slippage guard: tokens-out &lt; minTokens throws → op invalid → deposit later refunded by netted settlement (07).</bpmn:documentation>
      <bpmn:incoming>Flow_Buy_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Buy_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Event_Buy_Credited" name="credited">
      <bpmn:incoming>Flow_Buy_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="Event_Buy_Skipped" name="skipped (unbacked / misrouted)">
      <bpmn:incoming>Flow_Buy_6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Buy_1" sourceRef="Event_Buy_Start" targetRef="Task_Buy_Deposit"/>
    <bpmn:sequenceFlow id="Flow_Buy_2" sourceRef="Task_Buy_Deposit" targetRef="Task_Buy_Op"/>
    <bpmn:sequenceFlow id="Flow_Buy_3" sourceRef="Task_Buy_Op" targetRef="Task_Buy_Chain"/>
    <bpmn:sequenceFlow id="Flow_Buy_4" sourceRef="Task_Buy_Chain" targetRef="Gateway_Buy_Routes"/>
    <bpmn:sequenceFlow id="Flow_Buy_5" sourceRef="Gateway_Buy_Routes" targetRef="Task_Buy_Bind" name="yes"/>
    <bpmn:sequenceFlow id="Flow_Buy_6" sourceRef="Gateway_Buy_Routes" targetRef="Event_Buy_Skipped" name="no"/>
    <bpmn:sequenceFlow id="Flow_Buy_7" sourceRef="Task_Buy_Bind" targetRef="Task_Buy_Apply"/>
    <bpmn:sequenceFlow id="Flow_Buy_8" sourceRef="Task_Buy_Apply" targetRef="Event_Buy_Credited"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Buy">
    <bpmndi:BPMNPlane id="BPMNPlane_Buy" bpmnElement="Process_Buy">
      <bpmndi:BPMNShape id="Shape_Lane_Buy_User" bpmnElement="Lane_Buy_User" isHorizontal="true"><dc:Bounds x="30" y="30" width="1240" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Buy_Indexer" bpmnElement="Lane_Buy_Indexer" isHorizontal="true"><dc:Bounds x="30" y="180" width="1240" height="180"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Buy_Start" bpmnElement="Event_Buy_Start"><dc:Bounds x="60" y="85" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Deposit" bpmnElement="Task_Buy_Deposit"><dc:Bounds x="150" y="73" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Op" bpmnElement="Task_Buy_Op"><dc:Bounds x="470" y="73" width="300" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Chain" bpmnElement="Task_Buy_Chain"><dc:Bounds x="90" y="240" width="230" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Routes" bpmnElement="Gateway_Buy_Routes" isMarkerVisible="true"><dc:Bounds x="380" y="245" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Bind" bpmnElement="Task_Buy_Bind"><dc:Bounds x="490" y="240" width="250" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Apply" bpmnElement="Task_Buy_Apply"><dc:Bounds x="790" y="240" width="260" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Credited" bpmnElement="Event_Buy_Credited"><dc:Bounds x="1110" y="252" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Buy_Skipped" bpmnElement="Event_Buy_Skipped"><dc:Bounds x="387" y="320" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Buy_1" bpmnElement="Flow_Buy_1"><di:waypoint x="96" y="103"/><di:waypoint x="150" y="103"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_2" bpmnElement="Flow_Buy_2"><di:waypoint x="410" y="103"/><di:waypoint x="470" y="103"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_3" bpmnElement="Flow_Buy_3"><di:waypoint x="620" y="133"/><di:waypoint x="205" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_4" bpmnElement="Flow_Buy_4"><di:waypoint x="320" y="270"/><di:waypoint x="380" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_5" bpmnElement="Flow_Buy_5"><di:waypoint x="430" y="270"/><di:waypoint x="490" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_6" bpmnElement="Flow_Buy_6"><di:waypoint x="405" y="295"/><di:waypoint x="405" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_7" bpmnElement="Flow_Buy_7"><di:waypoint x="740" y="270"/><di:waypoint x="790" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Buy_8" bpmnElement="Flow_Buy_8"><di:waypoint x="1050" y="270"/><di:waypoint x="1110" y="270"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
